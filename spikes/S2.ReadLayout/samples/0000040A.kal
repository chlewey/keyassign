key  56    <        >        none     none         -

dead ~ {
    space = ~
    A = Ã
    N = Ñ
    O = Õ
    a = ã
    n = ñ
    o = õ
}

dead ` {
    space = `
    A = À
    E = È
    I = Ì
    O = Ò
    U = Ù
    a = à
    e = è
    i = ì
    o = ò
    u = ù
}

dead ^ {
    space = ^
    A = Â
    E = Ê
    I = Î
    O = Ô
    U = Û
    a = â
    e = ê
    i = î
    o = ô
    u = û
}

dead ´ {
    space = ´
    A = Á
    E = É
    I = Í
    O = Ó
    U = Ú
    Y = Ý
    a = á
    e = é
    i = í
    o = ó
    u = ú
    y = ý
}

dead ¨ {
    space = ¨
    A = Ä
    E = Ë
    I = Ï
    O = Ö
    U = Ü
    a = ä
    e = ë
    i = ï
    o = ö
    u = ü
