key  2B    ç        Ç        U+007D   none         shift
key  2C    z        Z        none     none         shift
key  2D    x        X        none     none         shift
key  2E    c        C        none     none         shift
key  2F    v        V        none     none         shift
key  30    b        B        none     none         shift
key  31    n        N        none     none         shift
key  32    m        M        none     none         shift
