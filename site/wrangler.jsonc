{
  // Static landing page for keyassign.ilecto.app, served by Cloudflare Workers static assets.
  // Deploy from this folder with: npx wrangler deploy
  "name": "keyassign-site",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "keyassign.ilecto.app", "custom_domain": true }
  ]
}
